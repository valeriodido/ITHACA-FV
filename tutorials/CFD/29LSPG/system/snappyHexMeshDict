FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Which of the steps to run
castellatedMesh true;
snap            true;
addLayers       true;

debug 0;
mergeTolerance 1e-6;


geometry
{
    cylinder1
    {
        type searchableCylinder;
        point1 (0 0 -2.5);    // Height
        point2 (0 0 2.5);    // Vector
        radius 0.5; 
    }

    refinementBox
    {
          type searchableBox;
          min ( -2 -4 -3);
          max (18 4 3);    
    }

    suprefinementBox1
    {
          type searchableBox;
          min ( -1 -1.5 -6);
          max (8 1.5 6);    
    }  

    suprefinementCylinder1
    {
        type searchableCylinder;
        point1 (0 0 -2.5);    // Height
        point2 (0 0 2.5);    // Vector
        radius 0.75; 
    }

};
castellatedMeshControls
{
    maxLocalCells 3000000;
    maxGlobalCells 5000000;
    minRefinementCells 50;
    nCellsBetweenLevels 6;
    features
    (
    );
    refinementSurfaces
    {  
        cylinder1
        {
            level (5 6);

            patchInfo
            {
                type wall;
            }
        }
        
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
      
       refinementBox
        {
            mode inside;
            levels ((1 1));
        }
       suprefinementBox1
        {
            mode inside;
            levels ((2 2));
        }
       
        suprefinementCylinder1
        {
            mode inside;
            levels ((4 4));
        }
    }
    
    locationInMesh (8 0 0);
    allowFreeStandingZoneFaces true;
}


snapControls
{
    nSmoothPatch 5;
    tolerance 1.0;
    nSolveIter 150;
    nRelaxIter 5;
}

addLayersControls
{
    relativeSizes false;

    layers
    {
        cylinder1
        {
            nSurfaceLayers 4;
        }
    }

    expansionRatio 1.2;
    finalLayerThickness 1e-2;
    minThickness 5e-3;
    nGrow 1;
    featureAngle 30;
    nRelaxIter 10;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.8;
    maxThicknessToMedialRatio 0.8;
    minMedialAxisAngle 40;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
    nRelaxedIter 20;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-250;
    minTetQuality 1e-25;
    minArea -1;
    minTwist 0.05;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 1e-1;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;

    relaxed
    {
        maxNonOrtho 75;
        maxBoundarySkewness 30;
        maxInternalSkewness 5;
    }
}



